# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env` or `.env.local` — they contain secrets.

# --- Supabase (public, safe to expose to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Supabase service role (SERVER ONLY — bypasses Row Level Security) ---
# Must never be prefixed with NEXT_PUBLIC_ and must never reach the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Feature flags ---
NEXT_PUBLIC_USE_SUPABASE=true
NEXT_PUBLIC_ENABLE_REALTIME=true
NEXT_PUBLIC_ENABLE_ADMIN_DASHBOARD=true
NEXT_PUBLIC_ENABLE_AUTH=true
